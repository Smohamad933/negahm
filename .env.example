# ============================================================
#  نگاه مدیا — تنظیمات محیطی
#  این فایل را با نام .env کپی کنید و مقادیر را پر کنید.
#  اگر فایل .env وجود نداشته باشد، مقادیر پیش‌فرض config/config.php استفاده می‌شود.
# ============================================================

APP_NAME="نگاه مدیا"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://negahm.ir
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa

# مسیر پایه نصب (اگر سایت در زیرپوشه نصب شده، مثلا /negahm ؛ در غیر این صورت خالی)
APP_BASE_PATH=

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=negahm
DB_USERNAME=negahm_user
DB_PASSWORD=changeme
DB_CHARSET=utf8mb4

# salt منحصر به فرد برای رمزنگاری کوکی‌ها
APP_KEY=please-change-this-to-a-random-64-char-string

UPLOAD_MAX_SIZE=8388608
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp,gif,svg
ALLOWED_FILE_TYPES=pdf,zip,mp4,webm,woff2,woff,ttf,otf

# ایمیل — MAIL_NOTIFY دریافت‌کننده اطلاع پیام‌های جدید فرم تماس است
MAIL_FROM=info@negahm.ir
MAIL_FROM_NAME="نگاه مدیا"
MAIL_NOTIFY=info@negahm.ir
